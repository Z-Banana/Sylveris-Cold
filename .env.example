# ===== Sylveris 春林冷知 环境变量示例 =====
# 复制为 .env 并填写（本地开发可留空，数据落到 data/store.json）

# Turso 数据库连接串（云端必填，页面内容与后台数据都存这里）
# 获取：turso db show chunlin-cold --url
TURSO_DATABASE_URL=

# Turso 认证令牌（云端必填）
# 获取：turso db tokens create chunlin-cold
TURSO_AUTH_TOKEN=

# 后台隐藏路径（可选，默认 /linjian-7c4f/）
# 改成别的地址后，站内链接与 sitemap 都不会出现它，robots.txt 也会自动 Disallow
ADMIN_PATH=

# 后台登录密码：不写在这里！
# 用命令设置，只保存 scrypt 哈希，明文不留存：
#   npm run set-password
# 本地查看是否已设置：npm run set-password -- --check

# 便利令牌（可选）：给 curl 直接当 Bearer 用，与密码登录二选一
ADMIN_TOKEN=

# 应急开关（可选）：设为 1 时构建全量静态站，页面脱离数据库也能跑
# Vercel 上改这个值后需要 Redeploy；恢复时删掉即可
STATIC_FALLBACK=
